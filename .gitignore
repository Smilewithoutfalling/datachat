# 密钥与本地配置（绝不提交）
.env

# 运行产物
outputs/
__pycache__/
*.pyc

# 编辑器
.vscode/
.idea/

# Python 环境与缓存（M11）
.venv/
.pytest_cache/

# 阶段 3.5 闸门的外部数据（scripts/gate/build_gate_data.py 下载约 90 MB、生成后磁盘约 173 MB）
data/gate/

# 阶段 4 sidecar 打包产物
dist/
build/

# 留出集（H1）：题面与数据都不进 git（scripts/holdout/README.md 规则 1）
# .holdout_path 是一行本机绝对路径 —— 不进版本库，否则等于把题库位置公开在一个会被 fork 的仓库里
.holdout_path
