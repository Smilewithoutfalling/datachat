{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataChat",
  "version": "0.1.1",
  "identifier": "com.smilewithoutfalling.datachat",
  "build": {
    "frontendDist": "../static"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "sidecar/": "sidecar/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./hooks.nsh",
        "template": "./installer.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBQUE4RkU4OTM0NTVBMEQKUldRTldrV1Q2SStxK3Y0Q0VZajRFYm91ZVVneEJhZi9PT3BSU0treEo1Y1d0b3I5ZHlSdnMzZ2UK",
      "endpoints": [
        "https://github.com/Smilewithoutfalling/datachat/releases/download/update-channel/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
